# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
build-venv/

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Local env overrides (machine-specific, e.g. dev proxy backend port)
.env.local
.env.*.local

# PyInstaller build intermediates (root)
/build/

# Compiled binaries / release artifacts (root)
/dist/

# Runtime data: database, uploads, thumbnails, posts
/data/
/config/
/logs/
/models/

# Generated by browser-extension/native-host/install-native-host.ps1 with local paths
/browser-extension/native-host/nekobooru_launcher_host.cmd

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Android
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/captures/
*.apk
*.keystore
# Opaque, unreviewed binary used only by ./gradlew. Kept out of the tree on
# purpose; regenerate when an Android build is needed:
#   gradle wrapper --gradle-version 8.10.2
/android/gradle/wrapper/gradle-wrapper.jar
