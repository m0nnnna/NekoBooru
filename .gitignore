# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Local env overrides (machine-specific, e.g. dev proxy backend port)
.env.local
.env.*.local

# PyInstaller build intermediates (root)
/build/

# Compiled binaries / release artifacts (root)
/dist/

# Runtime data: database, uploads, thumbnails, posts
/data/
/config/
/logs/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Android
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/captures/
*.apk
*.keystore
