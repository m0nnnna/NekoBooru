#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nekobooru"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/nekobooru"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/nekobooru"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nekobooru"

echo "This removes NekoBooru user data for the current user:"
echo "  $CONFIG_DIR"
echo "  $DATA_DIR"
echo "  $CACHE_DIR"
echo "  $STATE_DIR"
echo
printf "Type DELETE to continue: "
read -r confirm
if [ "$confirm" != "DELETE" ]; then
  echo "Cancelled."
  exit 0
fi

rm -rf "$CONFIG_DIR" "$DATA_DIR" "$CACHE_DIR" "$STATE_DIR"
echo "NekoBooru user data removed for $USER."
