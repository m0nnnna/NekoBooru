#!/bin/sh
set -e

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user daemon-reload >/dev/null 2>&1 || true
fi

echo "NekoBooru installed. Run 'nekobooru' or use the desktop launcher."
echo "User data is stored in XDG paths, not /opt/nekobooru."
echo "Run 'nekobooru-configure' to reconfigure ports, AI runtime, updates, and browser integration."
echo "Run 'nekobooru-repair' to repair the user runtime and native host registration."
