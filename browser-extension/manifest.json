{
  "manifest_version": 3,
  "name": "Download to NekoBooru",
  "version": "4.0.0",
  "description": "Right-click to upload web images/videos to your NekoBooru instance, or browse your instance and insert media into whatever you're posting.",
  "permissions": ["contextMenus", "storage", "notifications", "clipboardWrite", "downloads", "nativeMessaging"],
  "host_permissions": ["*://*/*"],
  "optional_permissions": ["cookies"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["track-cursor.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "NekoBooru settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
