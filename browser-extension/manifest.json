{
  "manifest_version": 3,
  "name": "Download to NekoBooru",
  "version": "1.0.0",
  "description": "Right-click any image or video and upload it to your NekoBooru instance with tags and a rating.",
  "permissions": ["contextMenus", "storage", "notifications"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["track-cursor.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "NekoBooru settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
