        "Danbooru asked to slow down · retrying in 60 s…"
      ],
      "outcome": "imported"
    },
    {
      "name": "a fourth 429 fails the post with the site's message",
      "failures": ["Upstream returned HTTP 429", "Upstream returned HTTP 429", "Upstream returned HTTP 429", "Upstream returned HTTP 429"],
      "expectedSleepsMs": [10000, 30000, 60000],
      "expectedRetryTexts": [
